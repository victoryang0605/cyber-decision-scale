# DEEPSEEK_API_KEY: Required for DeepSeek AI API calls (OpenAI-compatible).
# Get one at https://platform.deepseek.com/
DEEPSEEK_API_KEY="MY_DEEPSEEK_API_KEY"

# DEEPSEEK_MODEL: Optional. Defaults to "deepseek-chat" (DeepSeek-V3).
# Alternatives: "deepseek-reasoner" (DeepSeek-R1). Note: deepseek-reasoner
# does not support JSON mode, so the response is parsed defensively.
DEEPSEEK_MODEL="deepseek-chat"

# DEEPSEEK_BASE_URL: Optional. Defaults to "https://api.deepseek.com".
# Useful for proxies or self-hosted OpenAI-compatible gateways.
DEEPSEEK_BASE_URL="https://api.deepseek.com"

# FREE_QUOTA_LIMIT: 每个匿名用户可免费调用站长 Key 的次数（默认 3）。
# 用户接入自己的 DeepSeek Key 后不消耗该额度。
FREE_QUOTA_LIMIT=3

# APP_URL: The URL where this app is hosted.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"
